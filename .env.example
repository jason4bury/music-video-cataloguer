# Copy this file to .env (in the same folder as docker-compose.yml) and
# fill in your own values. .env is gitignored — it holds your real paths
# and password, so it never gets committed or pushed.

# Folder containing one subfolder per artist, e.g.
# E:/Music_Vids/Daft Punk/Daft Punk - Around the World.mp4
LIBRARY_PATH=

# Where the SQLite database and generated thumbnails are stored on the host
CONFIGS=

# Port the app is reachable on
APP_PORT=3001

# Login credentials — only used to create the account on the very first
# start. Leave AUTH_PASSWORD blank to have one generated and printed to
# `docker compose logs` instead.
AUTH_USERNAME=admin
AUTH_PASSWORD=changeme

# How often (minutes) to automatically rescan the library; 0 disables it
SCAN_INTERVAL_MINUTES=60

# Optional — set this to a long random string so sessions survive a
# container restart instead of signing everyone out.
# SESSION_SECRET=

